{
  "name": "lenquant-website-fabric",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:backend": "python -m uvicorn app.main:app --reload --app-dir apps/backend",
    "dev": "npm run dev:web",
    "lint:web": "npm --workspace apps/web run lint"
  },
  "overrides": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0",
    "puppeteer": "^25.1.0",
    "wrangler": "^4.127.1"
  }
}
