iv class=\"hero-wave-shell\" style=\"--wave-hue:196;--wave-secondary-hue:156\" aria-hidden=\"true\"><canvas data-engine=\"three.js r183\" width=\"416\" height=\"280\" style=\"display: block;\"></canvas></div></div></div></div></section>","ctas":[],"imageUrls":[],"assetUrls":[],"improvementNotes":["Clarify the next action for this section."],"confidence":63,"screenshotUrl":"C:\\tmp\\lenquant_assets\\visual-captures\\LenQuant\\crawl-bfa05eaf2df646c9a39d8131a14e427a\\02-about-section-01.png","boundingBox":{"x":0.0,"y":84.1875,"width":1440.0,"height":542.0},"computedStyles":{"backgroundColor":"rgba(0, 0, 0, 0)","color":"rgb(250, 250, 250)","fontFamily":"\"Plus Jakarta Sans\", sans-serif","padding":"104px 0px 32px","margin":"0px","fontSize":"16px"}},{"id":"section-2","index":2,"type":"unknown","tagName":"article","selector":"article.card.manifesto.tone-emerald","heading":"What LenQuant is","text":"COMPANY VIEW\n\nLenQuant sits between product building, applied AI, and selective new ventures.\n\nThat balance gives the company room to ship products, incubate new ideas, and take on selective partnerships without reading like an agency.\n\nWhat LenQuant is\nA focused company with a clear product philosophy\nA company with multiple product lines\nA team capable of building focused products across different categories\nWhat LenQuant is not\nA pure holding company\nA broad services marketplace\nA random collection of unrelated product experiments","html":"<section class=\"section\"><div class=\"container\"><div class=\"section-header section-header-with-lead\"><div class=\"section-header-lead\"><div class=\"section-accent-icon section-accent-icon-stagger\" aria-hidden=\"true\"><canvas data-engine=\"three.js r183\" width=\"150\" height=\"150\" style=\"display: block;\"></canvas></div></div><div class=\"section-header-copy\"><p class=\"eyebrow\">Company View</p><h2>LenQuant sits between product building, applied AI, and selective new ventures.</h2><p class=\"section-description\"