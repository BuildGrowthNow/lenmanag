# ─── MongoDB ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://fern2gue:hJk7CDkZuwssFDz4@lenmanag.zzbkrv.mongodb.net/
MONGODB_DB_NAME=lenmanag

# ─── Authentication ───────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-secure-random-string-for-jwt
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=168
SIGNUP_CODE=your-secret-signup-code-here
VERIFICATION_TOKEN_EXPIRY_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24
REQUIRE_EMAIL_VERIFICATION=true
AUTH_ALLOWLIST_EMAILS=admin@example.com,fern2gue@gmail.com,operator@example.com,admin@example.com
AUTH_ALLOWLIST_DOMAINS=lenquant.com,lengrowth.com,sites.lengrowth.com,sites.lenquant.com,sites-api.lenquant.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
# Set to .lenquant.com to share cookies across sites.lenquant.com and sites-api.lenquant.com
SESSION_COOKIE_DOMAIN=.lenquant.com
SESSION_COOKIE_MAX_AGE_SECONDS=28800

# ─── Application URLs ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://sites-api.lenquant.com
NEXT_PUBLIC_APP_URL=https://sites.lenquant.com
BACKEND_CORS_ORIGINS=https://sites.lenquant.com
PREVIEW_BASE_URL=https://sites.lenquant.com/st
FRONTEND_URL=https://sites.lenquant.com

# ─── Celery / Redis ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
CELERY_DEFAULT_QUEUE=lenquant
CELERY_TASK_ALWAYS_EAGER=true

# ─── LLM Provider (cloudflare, gemini, or bedrock) ─────────────────
LLM_PROVIDER=cloudflare

# Cloudflare Workers AI (primary + ordered text fallbacks)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-api-token
CLOUDFLARE_MODEL=@cf/deepseek-ai/deepseek-v4-pro-0813
CLOUDFLARE_FALLBACK_MODELS=@cf/zai-org/glm-5.3,@cf/qwen/qwen3.8-27b,@cf/deepseek-ai/deepseek-v4-flash-0731,@cf/zai-org/glm-5.3-flash
CLOUDFLARE_VISION_MODEL=@cf/zai-org/glm-5.3-flash
CLOUDFLARE_TIMEOUT_SECONDS=600

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# Amazon Bedrock (used when LLM_PROVIDER=bedrock)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-v1
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=4096

# ─── AWS Credentials (required for S3 and Bedrock) ────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── Asset Storage ────────────────────────────────────────────────
ASSET_STORAGE_BACKEND=local
ASSET_DOWNLOAD_ENABLED=false
ASSET_S3_BUCKET=lenquant-site-assets
ASSET_S3_REGION=us-east-1

# ─── Visual Redesign ─────────────────────────────────────────────
VISUAL_REDESIGN_ENABLED=true
VISUAL_REDESIGN_MAX_ITERATIONS=2
VISUAL_REDESIGN_QUALITY_THRESHOLD=95


# ─── Compiler Service (for TSX compilation) ─────────────────────
# Production (Docker Compose): http://compiler:3001
# Development (local): http://localhost:3001
COMPILER_SERVICE_URL=http://localhost:3001

# ─── Crawl Settings ───────────────────────────────────────────────
CRAWL_MAX_PAGES=10
CRAWL_BUDGET_BYTES=3145728
CRAWL_TIME_LIMIT_SECONDS=60

# ─── Stripe Payment ───────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-payment-link-here

# ─── Resend Email ─────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=orders@lenquant.com
RESEND_ADMIN_EMAIL=fern2gue@gmail.com
