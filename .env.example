# ─── MongoDB ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://fern2gue:hJk7CDkZuwssFDz4@lenmanag.zzbkrv.mongodb.net/
MONGODB_DB_NAME=lenmanag

# ─── Authentication ───────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-string
AUTH_ALLOWLIST_EMAILS=admin@example.com,fern2gue@gmail.com,operator@example.com,admin@example.com
AUTH_ALLOWLIST_DOMAINS=lenquant.com,lengrowth.com,sites.lengrowth.com,sites.lenquant.com,sites-api.lenquant.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_MAX_AGE_SECONDS=28800

# ─── Application URLs ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://sites-api.lenquant.com
NEXT_PUBLIC_APP_URL=https://sites.lenquant.com
BACKEND_CORS_ORIGINS=https://sites.lenquant.com
PREVIEW_BASE_URL=https://sites.lenquant.com/st

# ─── Celery / Redis ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
CELERY_DEFAULT_QUEUE=lenquant
CELERY_TASK_ALWAYS_EAGER=true

# ─── LLM Provider ("gemini" for local, "bedrock" for production) ──
LLM_PROVIDER=bedrock

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# Amazon Bedrock (used when LLM_PROVIDER=bedrock)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-v1
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=4096

# ─── AWS Credentials (required for S3 and Bedrock) ────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── Asset Storage ────────────────────────────────────────────────
ASSET_STORAGE_BACKEND=local
ASSET_DOWNLOAD_ENABLED=false
ASSET_S3_BUCKET=lenquant-site-assets
ASSET_S3_REGION=us-east-1

# ─── Visual Redesign ─────────────────────────────────────────────
VISUAL_REDESIGN_ENABLED=true
VISUAL_REDESIGN_MAX_ITERATIONS=2
VISUAL_REDESIGN_QUALITY_THRESHOLD=95


# ─── Crawl Settings ───────────────────────────────────────────────
CRAWL_MAX_PAGES=10
CRAWL_BUDGET_BYTES=3145728
CRAWL_TIME_LIMIT_SECONDS=60