# ═══════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════

# --- MongoDB Configuration ---
MONGODB_URI=mongodb+srv://[username]:[password]@[cluster].mongodb.net/
MONGODB_DB_NAME=lenmanag_prod

# --- Session Configuration ---
SESSION_SECRET=[generate-with-openssl-rand-base64-32]
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
SESSION_COOKIE_DOMAIN=.lenquant.com
SESSION_COOKIE_MAX_AGE_SECONDS=28800

# --- Authentication ---
JWT_SECRET=[generate-with-openssl-rand-base64-32]
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=168
SIGNUP_CODE=[your-secret-signup-code]
AUTH_ALLOWLIST_EMAILS=admin@example.com,fern2gue@gmail.com
AUTH_ALLOWLIST_DOMAINS=lenquant.com,lengrowth.com,sites.lenquant.com
AUTH_ADMIN_PASSWORD=[generate-with-openssl-rand-base64-24]

# --- Application URLs ---
NEXT_PUBLIC_APP_URL=https://sites.lenquant.com
NEXT_PUBLIC_API_BASE_URL=https://sites-api.lenquant.com
BACKEND_CORS_ORIGINS=https://sites.lenquant.com
FRONTEND_URL=https://sites.lenquant.com

# --- Stripe Payment Integration ---
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/[your-payment-link]

# --- Email Service (Resend) ---
RESEND_API_KEY=re_[your-production-key]
RESEND_FROM_EMAIL=orders@lenquant.com
RESEND_ADMIN_EMAIL=admin@lenquant.com

# --- Redis Configuration ---
REDIS_PASSWORD=[secure-redis-password]
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1

# --- LLM Provider Configuration ---
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-v1
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=4096

# --- AWS Credentials (for Bedrock and S3) ---
AWS_ACCESS_KEY_ID=[your-access-key]
AWS_SECRET_ACCESS_KEY=[your-secret-key]
AWS_DEFAULT_REGION=us-east-1

# --- Asset Storage ---
ASSET_STORAGE_BACKEND=s3
ASSET_S3_BUCKET=lenquant-site-assets-prod
ASSET_S3_REGION=us-east-1
ASSET_DOWNLOAD_ENABLED=false

# --- Monitoring & Logging ---
LOG_LEVEL=warning
SENTRY_DSN=[your-sentry-dsn-for-error-tracking]

# --- Security ---
SECURE_SSL_REDIRECT=true
ALLOWED_HOSTS=sites.lenquant.com,sites-api.lenquant.com

# --- Database Backups ---
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# --- Performance ---
CACHE_ENABLED=true
CACHE_TTL=3600
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=60

# --- Monitoring ---
HEALTH_CHECK_ENABLED=true
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# ═══════════════════════════════════════════════════════════════════════════
# GENERATION
# Generated: 2026-07-15
# Environment: PRODUCTION
# ═══════════════════════════════════════════════════════════════════════════
